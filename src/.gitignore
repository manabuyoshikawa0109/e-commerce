# CakePHP specific files #
##########################
/config/app_local.php
/config/.env
/logs/*
/tmp/*
/vendor/*

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
# macOS がフォルダのカスタムアイコン用に作る "Icon\r" を除外する。
#
# Icon? だと ? が任意の1文字に一致し、icons ディレクトリまで巻き込む。
# Icon[\r] は Git が \r を復帰文字と解釈しないため（文字 r のエスケープ扱い）効かない。
# 制御文字クラスを使うのが唯一正しく動く書き方。
Icon[[:cntrl:]]
ehthumbs.db
Thumbs.db
.directory

# Tool specific files #
#######################
# vim
*~
*.swp
*.swo
# sublime text & textmate
*.sublime-*
*.stTheme.cache
*.tmlanguage.cache
*.tmPreferences.cache
# Eclipse
.settings/*
# JetBrains, aka PHPStorm, IntelliJ IDEA
.idea/*
# NetBeans
nbproject/*
# Visual Studio Code
.vscode
# Sass preprocessor
.sass-cache/
